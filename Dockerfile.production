FROM node@sha256:4f696fbf39f383c1e486030ba6b289a5d9af541642fc78ab197e584a113b9c03 AS workspace
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@12.23.0 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc tsconfig.base.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json

FROM workspace AS build
RUN pnpm install --frozen-lockfile
COPY apps ./apps
COPY packages ./packages
RUN pnpm build

FROM workspace AS api
RUN pnpm --filter @nri/server... install --prod --frozen-lockfile \
    && mkdir -p /app/.data/uploads && chown -R node:node /app/.data
COPY --from=build /app/apps/server/dist ./apps/server/dist
COPY --from=build /app/apps/server/drizzle ./apps/server/drizzle
COPY apps/server/scripts/prune-operation-receipts.mjs ./apps/server/scripts/prune-operation-receipts.mjs
COPY --from=build /app/packages/contracts/src ./packages/contracts/src
WORKDIR /app/apps/server
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 UPLOAD_DIR=/app/.data/uploads
USER node
EXPOSE 3000
CMD ["node", "dist/index.js"]

FROM nginx@sha256:b0f7830b6bfaa1258f45d94c240ab668ced1b3651c8a222aefe6683447c7bf55 AS proxy
COPY deploy/production/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
