{
  "name": "@nri/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed:playable-amber": "tsx src/seedPlayableAmber.ts",
    "smoke": "node scripts/multiplayer-smoke.mjs",
    "test:movement": "node scripts/transactional-movement.mjs",
    "test:object-lifecycle": "node scripts/transactional-object-lifecycle.mjs",
    "test:realtime": "node scripts/secure-realtime.mjs",
    "test:private-channels": "node scripts/private-channels.mjs",
    "test:command-authorization": "node scripts/command-authorization.mjs",
    "test:retry": "node scripts/retry-recovery.mjs",
    "test:retry-migration-upgrade": "node scripts/retry-migration-upgrade.mjs",
    "db:prune-operation-receipts": "node scripts/prune-operation-receipts.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.3.0",
    "@nri/contracts": "workspace:*",
    "argon2": "0.45.2",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.4",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
